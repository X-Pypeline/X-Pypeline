    dag_xtmva.set_dag_file( 'grb_xtmva' )
    xtmvajob  = xcondor.XtmvaJob(cp,len(detector))
    xtmvanode = xcondor.XtmvaNode(xtmvajob)
    xtmvanode.set_retry("1")
    xtmvanode.set_name("xtmva_on_source_" + xtmvanode.get_name())

